<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- A dark parent theme is also what tells the page to use its dark colours. -->
    <style name="AppTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@color/paper</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
    </style>

    <style name="PopupTheme" parent="android:Theme.Material.Dialog.NoActionBar">
        <item name="android:windowBackground">@drawable/popup_bg</item>
        <item name="android:colorAccent">@color/blue</item>
        <item name="android:backgroundDimAmount">0.55</item>
    </style>
</resources>
